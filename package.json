{
  "name": "fullstack-serverless",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"pnpm --filter api run start\" \"pnpm --filter frontend run start\"",
    "prettier:fix": "git ls-files -mo --exclude-standard -- './packages' | grep -E '\\.(ts|tsx)$' | xargs -I {} prettier --write {}",
    "prettier:fix:full": "prettier --write \"./packages/**/*.+(ts|tsx)\"",
    "knip": "knip --reporter compact",
    "dead-code": "concurrently -n knip,slop-api,slop-frontend -c magenta,green,blue \"knip --reporter compact\" \"slop-scan scan packages/api --lint\" \"slop-scan scan packages/frontend --lint\"",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "export-public-code": "./export-public-code.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "git-filter": "2.4.1",
    "knip": "^6.9.0",
    "prettier": "^3.5.3",
    "slop-scan": "^0.3.0"
  }
}
