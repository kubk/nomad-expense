{
  "name": "fullstack-serverless",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"pnpm --filter api run start\" \"pnpm --filter frontend run start\"",
    "prettier:fix": "git ls-files -mo --exclude-standard -- './packages' | grep -E '\\.(ts|tsx)$' | xargs -I {} prettier --write {}",
    "prettier:fix:full": "prettier --write \"./packages/**/*.+(ts|tsx)\"",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:knip": "knip --reporter compact",
    "lint:oxlint": "oxlint --format=agent",
    "lint:slop-police": "slop-police",
    "dead-code": "concurrently -n knip,slop-police -c magenta,green \"knip --reporter compact\" \"slop-police\"",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "export-public-code": "git-filter git-filter.config.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "git-filter": "2.6.0",
    "knip": "^6.9.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.5.3",
    "slop-police": "^0.3.5"
  }
}
